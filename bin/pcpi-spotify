#!/usr/bin/env python3
"""Conectar los botones de la pantalla con tu Spotify (una sola vez).

  pcpi-spotify login      inicia sesion (te da un enlace; abre en tu movil/PC y pega aqui la direccion final)
  pcpi-spotify status     dice si esta conectado
  pcpi-spotify logout     borra los tokens guardados

Antes: crea una app gratis en https://developer.spotify.com/dashboard con la Redirect URI
  http://127.0.0.1:8888/callback
y pon su Client ID:  pcpi-config set spotify client_id TU_CLIENT_ID
(necesitas Spotify Premium; Spotify no deja controlar la musica a las cuentas gratuitas)."""
import os
import secrets
import sys
from pathlib import Path

sys.dont_write_bytecode = True
HERE = Path(os.path.realpath(__file__)).parent
for cand in (HERE.parent / "home", Path("/opt/pcpi/home")):
    if (cand / "spotify_ctl.py").exists():
        sys.path.insert(0, str(cand))
        break
import pcpiconf  # noqa: E402
import spotify_ctl as sp  # noqa: E402


def client_id():
    cp = pcpiconf.load(os.environ.get("PCPI_CONF", "/etc/pcpi/pcpi.conf"))
    return cp.get("spotify", "client_id", fallback="").strip()


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "status":
        print("Conectado" if sp.logged_in() else "No conectado (pcpi-spotify login)")
        return 0
    if cmd == "logout":
        sp.logout()
        print("Sesión de Spotify borrada")
        return 0
    if cmd != "login":
        print(__doc__)
        return 2
    cid = client_id()
    if not cid:
        print("Falta el Client ID. Crea la app (mira la ayuda: pcpi-spotify) y ejecuta:\n  pcpi-config set spotify client_id TU_CLIENT_ID", file=sys.stderr)
        return 1
    verifier, state = sp.make_verifier(), secrets.token_urlsafe(12)
    print("1) Abre este enlace en cualquier navegador (móvil o PC) e inicia sesión:\n\n" + sp.login_url(cid, verifier, state) + "\n")
    print("2) Al aceptar, el navegador mostrará un error de «no se puede conectar» a 127.0.0.1: es normal.")
    print("   Copia la dirección COMPLETA de la barra (empieza por http://127.0.0.1:8888/callback?code=...) y pégala aquí.\n")
    try:
        pasted = input("Dirección: ")
        sp.exchange(cid, sp.code_from_redirect(pasted, state), verifier)
    except (sp.SpotifyError, EOFError) as e:
        print("Error: %s" % e, file=sys.stderr)
        return 1
    print("Listo: Spotify conectado. Ya puedes usar los botones de la pantalla.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
