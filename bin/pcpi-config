#!/usr/bin/env python3
"""Lee y cambia ajustes de /etc/pcpi/pcpi.conf SIN borrar tus comentarios.

  pcpi-config get SECCION CLAVE
  pcpi-config set SECCION CLAVE VALOR
Ejemplo:  pcpi-config set weather lat 28.1235
"""
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True
HERE = Path(os.path.realpath(__file__)).parent
for cand in (HERE.parent / "home", Path("/opt/pcpi/home")):
    if (cand / "confedit.py").exists():
        sys.path.insert(0, str(cand))
        break
import confedit  # noqa: E402
from confedit import get, section_range, set_value, split  # noqa: E402  (se reexportan: las pruebas los usan desde aqui)

__all__ = ["get", "section_range", "set_value", "split", "main"]

PATH = os.environ.get("PCPI_CONF", "/etc/pcpi/pcpi.conf")


def main(argv):
    if len(argv) < 4 or argv[1] not in ("get", "set") or (argv[1] == "set" and len(argv) != 5):
        print(__doc__, file=sys.stderr)
        return 2
    try:
        text = open(PATH, encoding="utf-8").read()
    except FileNotFoundError:
        text = ""
    if argv[1] == "get":
        v = get(text, argv[2], argv[3])
        if v is None:
            return 1
        print(v)
        return 0
    confedit.write_atomic(PATH, set_value(text, argv[2], argv[3], argv[4]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
