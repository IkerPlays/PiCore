#!/usr/bin/env python3
"""Revisa (y arregla) los videos de la pantalla de Inicio (extra-assets/start/Inicio1..4.mp4).

  pcpi-intros check                    que codec lleva cada video y si Chromium lo reproducira
  pcpi-intros convert [--yes] [--max-mb N] [--only Inicio2.mp4]
                                       crea una copia en H.264 de los que lleven H.265/HEVC/AV1

Por que: Chromium en la Raspberry Pi reproduce H.264 sin problemas, pero H.265 (HEVC) / AV1 puede no verse (el video se
salta solo a los ~5 s). La copia se guarda en extra-assets/start/.h264/ y se usa AUTOMATICAMENTE en lugar del original;
tus originales no se tocan. Convertir tarda un rato (la Pi no es rapida) pero se hace una sola vez."""
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True          # no dejar __pycache__ dentro de /opt/pcpi
HERE = Path(os.path.realpath(__file__)).parent
for cand in (HERE.parent / "home", Path("/opt/pcpi/home")):
    if (cand / "intros_tool.py").exists():
        sys.path.insert(0, str(cand))
        break
import intros_tool as it  # noqa: E402


def check():
    if not it.have_tools():
        print("Falta ffmpeg/ffprobe: sudo apt install -y ffmpeg", file=sys.stderr)
        return 2
    vids = it.videos()
    if not vids:
        print("No hay videos en %s" % it.start_dir())
        return 0
    bad = 0
    for v in vids:
        p = it.probe(v)
        mb = v.stat().st_size / 1048576
        if p is None:
            print("✘ %-12s %7.1f MB  no se puede leer (¿archivo roto?)" % (v.name, mb))
            bad += 1
            continue
        codec, w, h, dur = p
        info = "%s %dx%d %.0fs" % (codec, w, h, dur)
        if codec in it.RISKY:
            if it.cached(v):
                print("✔ %-12s %7.1f MB  %s  → se usa la copia H.264 (.h264/)" % (v.name, mb, info))
            else:
                print("! %-12s %7.1f MB  %s  → puede NO reproducirse en Chromium: pcpi-intros convert" % (v.name, mb, info))
                bad += 1
        else:
            print("✔ %-12s %7.1f MB  %s" % (v.name, mb, info))
    return 1 if bad else 0


def convert(args):
    if not it.have_tools():
        print("Falta ffmpeg/ffprobe: sudo apt install -y ffmpeg", file=sys.stderr)
        return 2
    yes = "--yes" in args
    max_mb = None
    only = None
    if "--max-mb" in args:
        try:
            max_mb = float(args[args.index("--max-mb") + 1])
        except (IndexError, ValueError):
            print("--max-mb necesita un numero", file=sys.stderr)
            return 2
    if "--only" in args:
        try:
            only = {args[args.index("--only") + 1]}
        except IndexError:
            print("--only necesita un nombre de video", file=sys.stderr)
            return 2
    todo = [v for v in it.videos() if (not only or v.name in only) and it.needs_conversion(v)]
    if not todo:
        print("✔ Ningún video necesita conversión.")
        return 0
    print("Se harán copias H.264 de: %s" % ", ".join(v.name for v in todo))
    print("Tus originales no se tocan. Tarda un rato (más cuanto más grande el video).")
    if not yes and input("¿Continuar? [s/N] ").strip().lower() not in ("s", "si", "sí", "y", "yes"):
        print("Cancelado.")
        return 1
    done, failed, skipped = it.convert_all(max_mb=max_mb, only=only)
    return 1 if failed else 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if argv[0] == "check":
        return check()
    if argv[0] == "convert":
        return convert(argv[1:])
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
