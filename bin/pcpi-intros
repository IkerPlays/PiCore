#!/usr/bin/env python3
"""Revisa (y arregla) los videos de la pantalla de Inicio (extra-assets/start/Inicio1..4.mp4).

  pcpi-intros check            que codec lleva cada video y si Chromium lo reproducira
  pcpi-intros convert [--yes]  convierte a H.264 los que lleven H.265/HEVC (los originales se guardan aparte)

Por que: Chromium en la Raspberry Pi reproduce H.264 sin problemas, pero H.265 (HEVC) / AV1 puede no verse (el video se
salta solo a los ~5 s). Convertir tarda un rato (la Pi no es rapida) pero se hace una sola vez."""
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

SAFE = {"h264", "vp8", "vp9", "mpeg4"}
RISKY = {"hevc", "h265", "av1"}


def start_dir():
    return Path(os.environ.get("PCPI_ASSETS", "/opt/pcpi/extra-assets")) / "start"


def videos():
    names = ["Inicio.mp4"] + ["Inicio%d.mp4" % i for i in range(1, 5)]
    return [start_dir() / n for n in names if (start_dir() / n).is_file()]


def probe(path):
    """(codec, ancho, alto, segundos) o None si ffprobe no puede leerlo."""
    try:
        out = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                              "stream=codec_name,width,height:format=duration", "-of", "json", str(path)],
                             capture_output=True, text=True, timeout=60).stdout
        d = json.loads(out)
        s = d["streams"][0]
        return s["codec_name"], int(s.get("width", 0)), int(s.get("height", 0)), float(d.get("format", {}).get("duration") or 0)
    except (OSError, ValueError, KeyError, IndexError, subprocess.TimeoutExpired):
        return None


def check():
    if not shutil.which("ffprobe"):
        print("Falta ffprobe (viene con ffmpeg): sudo apt install -y ffmpeg", file=sys.stderr)
        return 2
    vids = videos()
    if not vids:
        print("No hay videos en %s" % start_dir())
        return 0
    bad = 0
    for v in vids:
        p = probe(v)
        mb = v.stat().st_size / 1048576
        if p is None:
            print("✘ %-12s %7.1f MB  no se puede leer (¿archivo roto?)" % (v.name, mb))
            bad += 1
            continue
        codec, w, h, dur = p
        if codec in RISKY:
            print("! %-12s %7.1f MB  %s %dx%d %.0fs  → puede NO reproducirse en Chromium: pcpi-intros convert" % (v.name, mb, codec, w, h, dur))
            bad += 1
        else:
            print("✔ %-12s %7.1f MB  %s %dx%d %.0fs" % (v.name, mb, codec, w, h, dur))
    return 1 if bad else 0


def convert(yes=False):
    for tool in ("ffmpeg", "ffprobe"):
        if not shutil.which(tool):
            print("Falta %s: sudo apt install -y ffmpeg" % tool, file=sys.stderr)
            return 2
    todo = [v for v in videos() if (probe(v) or ("",))[0] in RISKY]
    if not todo:
        print("✔ Ningún video necesita conversión.")
        return 0
    print("Se convertirán a H.264: %s" % ", ".join(v.name for v in todo))
    print("Los originales se guardan en ~/pcpi-intros-originales/. Tarda un rato (más cuanto más grande el video).")
    if not yes and input("¿Continuar? [s/N] ").strip().lower() not in ("s", "si", "sí", "y", "yes"):
        print("Cancelado.")
        return 1
    keep = Path(os.environ.get("PCPI_INTROS_BACKUP", str(Path.home() / "pcpi-intros-originales")))
    keep.mkdir(parents=True, exist_ok=True)
    fails = 0
    for v in todo:
        tmp = Path(tempfile.mkdtemp(dir=str(v.parent))) / v.name
        print("→ %s …" % v.name, flush=True)
        r = subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-i", str(v), "-c:v", "libx264", "-preset", "medium", "-crf", "20",
                            "-pix_fmt", "yuv420p", "-c:a", "aac", "-movflags", "+faststart", str(tmp)])
        if r.returncode != 0 or not tmp.exists() or tmp.stat().st_size == 0:
            print("✘ No se pudo convertir %s (el original sigue intacto)" % v.name, file=sys.stderr)
            shutil.rmtree(tmp.parent, ignore_errors=True)
            fails += 1
            continue
        shutil.copy2(v, keep / v.name)                 # copia del original
        os.replace(tmp, v)
        shutil.rmtree(tmp.parent, ignore_errors=True)
        print("✔ %s convertido (%.1f MB)" % (v.name, v.stat().st_size / 1048576))
    if fails == 0:
        print("Listo. Si más adelante ejecutas ./install.sh con tus videos originales del repositorio, volverán a copiarse sin convertir:"
              " repite entonces  pcpi-intros convert")
    return 1 if fails else 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if argv[0] == "check":
        return check()
    if argv[0] == "convert":
        return convert("--yes" in argv)
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
