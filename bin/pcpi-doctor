#!/usr/bin/env bash
# Diagnostico rapido de PiCore: que funciona y que no (y como arreglarlo).
PORT="${PCPI_PORT:-8080}"
ok()   { printf '  \033[32m✔\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; WARN=1; }
bad()  { printf '  \033[31m✘\033[0m %s\n' "$*"; BAD=1; }
WARN=0; BAD=0

echo "Modo y servidor"
if [ -f /etc/pcpi/pcpi.conf ]; then
  inline="$(grep -nE '^[^#;[:space:]][^#]*=.*[[:space:]]#' /etc/pcpi/pcpi.conf | head -3)"
  if [ -n "$inline" ]; then
    warn "pcpi.conf tiene comentarios detras de un valor (los servicios los toleran, pero conviene ponerlos en su propia linea):"
    printf '      %s\n' "$inline"
  else ok "/etc/pcpi/pcpi.conf sin problemas de formato"; fi
else bad "no existe /etc/pcpi/pcpi.conf (¿ejecutaste ./install.sh?)"; fi
if [ -f /etc/pcpi/pcpi.conf ]; then
  [ -w /etc/pcpi/pcpi.conf ] && ok "pcpi.conf se puede escribir (la ciudad, el Pi-hole y los ajustes de la pantalla se guardan solos)" \
    || warn "pcpi.conf no es escribible por tu usuario: los ajustes desde la pantalla no se guardarian (sudo chown \$USER /etc/pcpi /etc/pcpi/pcpi.conf)"
fi
mode="$(cat /etc/pcpi/mode 2>/dev/null)" && ok "modo actual: $mode" || bad "no existe /etc/pcpi/mode (¿ejecutaste ./install.sh?)"
if systemctl is-active --quiet pcpi-home 2>/dev/null; then ok "servicio pcpi-home activo"; else warn "pcpi-home no esta activo: sudo systemctl status pcpi-home"; fi
if st="$(curl -sf -m 4 "http://127.0.0.1:$PORT/api/status")"; then
  ok "API responde en :$PORT"
  python3 - "$st" <<'PY'
import json, sys
d = json.loads(sys.argv[1])
p = d["pihole"]
print("  %s Pi-hole: %s" % ("\033[32m✔\033[0m" if p["ok"] else "\033[33m!\033[0m",
      ("bloquea %s%% (%s)" % (p["percent"], p["blocking"])) if p["ok"] else "sin conexion (%s). En la pantalla de Casa toca «Conectar Pi-hole» (o revisa [pihole] en /etc/pcpi/pcpi.conf)" % p.get("error")))
w = d["weather"]
print("  %s Tiempo: %s" % ("\033[32m✔\033[0m" if w["ok"] else "\033[33m!\033[0m", "ok" if w["ok"] else "no configurado/sin red"))
c = d["camera"]
print("  %s Camara: %s" % ("\033[32m✔\033[0m" if c["available"] else "\033[33m!\033[0m", "disponible" if c["available"] else "no detectada (/dev/video0)"))
PY
else bad "la API no responde en :$PORT"; fi

pgrep -f "[p]cpi-session" >/dev/null && ok "vigilante de modos (pcpi-session) en marcha" \
  || warn "pcpi-session no esta en marcha (cierra sesion y vuelve a entrar; si sigue igual: pcpi-session &)"
# El servidor avisa a systemd de que esta vivo (Type=notify + WatchdogSec): si se cuelga, systemd lo reinicia solo
if systemctl cat pcpi-home >/dev/null 2>&1; then
  if systemctl show pcpi-home -p WatchdogUSec 2>/dev/null | grep -qv '=0$\|=infinity$'; then ok "vigilancia de systemd activa (se reinicia solo si se cuelga)"
  else warn "la unidad pcpi-home no tiene watchdog: actualiza con pcpi-update (o ./install.sh) para que se reinicie sola si se cuelga"; fi
fi
if [ -r /run/pcpi/alive ]; then
  age=$(( $(date +%s) - $(cat /run/pcpi/alive 2>/dev/null || echo 0) ))
  [ "$age" -lt 30 ] && ok "la pantalla da señales de vida (hace ${age} s)" || warn "la pantalla no da señales de vida desde hace ${age} s (si estas en modo Iker/Escritorio es normal)"
fi
[ -d /run/pcpi ] && ok "/run/pcpi existe (estado en RAM)" || warn "falta /run/pcpi: sudo systemd-tmpfiles --create /etc/tmpfiles.d/pcpi.conf"

echo "Alimentacion y temperatura (Raspberry Pi)"
if command -v vcgencmd >/dev/null; then
  thr="$(vcgencmd get_throttled | cut -d= -f2)"
  if [ "$thr" = "0x0" ]; then ok "sin avisos de voltaje ni temperatura"
  else warn "vcgencmd get_throttled=$thr (voltaje bajo o limitacion por calor): usa la fuente oficial de 27 W y revisa el ventilador"; fi
  ok "$(vcgencmd measure_temp)"
else warn "vcgencmd no existe (¿no es una Raspberry Pi?)"; fi

echo "Audio"
if command -v pcpi-sound >/dev/null; then
  if snd="$(pcpi-sound status 2>/dev/null)"; then
    ok "salida de sonido: $(python3 -c 'import json,sys; d=json.loads(sys.argv[1]); print("volumen %d%%%s (%s)" % (d["volume"], ", silenciado" if d["muted"] else "", d["backend"]))' "$snd" 2>/dev/null || echo "detectada")"
  else warn "no detecto la salida de sonido (¿altavoz/HDMI y sesion grafica?). Prueba: pcpi-sound status  y  pcpi-sound test"; fi
fi
if command -v arecord >/dev/null; then
  mics="$(arecord -l 2>/dev/null | grep -c '^card')"
  [ "$mics" -gt 0 ] && ok "$mics dispositivo(s) de captura: $(arecord -l | grep '^card' | sed 's/,.*//' | tr '\n' ' ')" \
                    || bad "no hay microfono. Conectalo y mira 'arecord -l'"
else warn "arecord no instalado (sudo apt install alsa-utils)"; fi
command -v espeak-ng >/dev/null && ok "espeak-ng instalado" || warn "falta espeak-ng (voz): ./install.sh --voice"

echo "Asistente de voz"
if [ -x /opt/pcpi/venv/bin/python ]; then
  /opt/pcpi/venv/bin/python -c "import vosk, openwakeword" 2>/dev/null && ok "vosk y openwakeword instalados" || bad "faltan vosk/openwakeword en /opt/pcpi/venv"
  [ -d /opt/pcpi/models/vosk-model-small-es-0.42 ] && ok "modelo de voz español" || bad "falta el modelo Vosk en /opt/pcpi/models"
  wm="$(sed -n 's/^wake_model *= *//p' /etc/pcpi/pcpi.conf 2>/dev/null | head -1)"
  ok "palabra de activacion: ${wm:-oye_pi}"
  if systemctl --user is-active --quiet pcpi-voice 2>/dev/null; then ok "servicio pcpi-voice activo"; else warn "pcpi-voice parado: systemctl --user status pcpi-voice"; fi
else warn "voz no instalada (./install.sh --voice)"; fi

echo "Camara"
ls /dev/video* >/dev/null 2>&1 && ok "$(ls /dev/video* | tr '\n' ' ')" || warn "sin /dev/video*"
command -v ffmpeg >/dev/null && ok "ffmpeg instalado" || warn "falta ffmpeg: ./install.sh --camera"
id -nG | grep -qw video && ok "usuario en el grupo video" || warn "tu usuario no esta en el grupo video (cierra sesion tras ./install.sh --camera)"

echo "Wi-Fi y pantallas de Inicio/Carga"
if command -v nmcli >/dev/null; then
  ok "NetworkManager (nmcli) disponible"
  id -nG | grep -qw netdev && ok "usuario en el grupo netdev (puede cambiar de wifi)" || warn "tu usuario no esta en el grupo netdev: sudo usermod -aG netdev \$USER y reinicia"
  pcpi-wifi status 2>/dev/null | sed 's/^/      /' || true
else warn "sin NetworkManager: el panel de Wi-Fi no estara disponible"; fi
n_intro="$(find /opt/pcpi/extra-assets/start -maxdepth 1 -type f \( -name 'Inicio.mp4' -o -name 'Inicio[1-4].mp4' \) 2>/dev/null | wc -l)"
[ "$n_intro" -gt 0 ] && ok "$n_intro video(s) de inicio en extra-assets/start (Inicio1..Inicio4.mp4)" \
  || warn "sin videos en extra-assets/start (Inicio1.mp4..Inicio4.mp4): al encender no habra video (opcional, ver extra-assets/README.md)"
if [ "$n_intro" -gt 0 ] && command -v ffprobe >/dev/null; then
  pcpi-intros check 2>/dev/null | sed 's/^/      /' || true
fi
[ -f /opt/pcpi/extra-assets/start/Inicio4.mp4 ] || warn "falta Inicio4.mp4: se descarga solo la primera vez que enciendas con internet (o en [boot] intro4_url)"
n_media="$(find /opt/pcpi/extra-assets/loading -type f ! -name '.*' ! -name '*.md' 2>/dev/null | wc -l)"
[ "$n_media" -gt 0 ] && ok "$n_media archivo(s) para la pantalla de carga" || warn "la pantalla de carga no tiene imagenes/videos (opcional, carpeta extra-assets/loading)"

echo "IA local (opcional)"
if [ "$(pcpi-config get ai enabled 2>/dev/null)" = "true" ]; then
  if curl -sf -m 3 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    ok "Ollama responde (modelo: $(pcpi-config get ai model 2>/dev/null))"
    ollama list 2>/dev/null | grep -q "$(pcpi-config get ai model 2>/dev/null)" && ok "modelo descargado" || warn "falta el modelo: ollama pull $(pcpi-config get ai model 2>/dev/null)"
  else warn "la IA esta activada pero Ollama no responde: sudo systemctl start ollama"; fi
else echo "  (desactivada; ./install.sh --ai la instala)"; fi

echo "Pi-hole y musica"
systemctl is-active --quiet pihole-FTL 2>/dev/null && ok "Pi-hole activo" || warn "Pi-hole no instalado/activo (./install.sh --pihole)"
n_mp3="$(find "${PCPI_MUSIC_DIR:-/var/lib/pcpi/music}" -maxdepth 1 -type f \( -iname '*.mp3' -o -iname '*.m4a' -o -iname '*.ogg' -o -iname '*.opus' -o -iname '*.flac' -o -iname '*.wav' \) 2>/dev/null | wc -l)"
[ "$n_mp3" -gt 0 ] && ok "Musix: $n_mp3 cancion(es) en el MP3 Player" || echo "  (Musix: el MP3 Player esta vacio; copia musica desde un USB o con DYMusic)"

if systemctl list-unit-files pcpi-stats.service >/dev/null 2>&1 && systemctl cat pcpi-stats >/dev/null 2>&1; then
  echo "Mini pantalla"
  systemctl is-active --quiet pcpi-stats && ok "servicio pcpi-stats activo" || warn "pcpi-stats parado: sudo systemctl status pcpi-stats"
  if command -v i2cdetect >/dev/null; then
    i2cdetect -y 1 2>/dev/null | grep -qE "3c|3d" && ok "pantalla detectada en el bus I2C (0x3C)" \
      || warn "no se ve ninguna pantalla en I2C: revisa los 4 cables (3V3, GND, SDA, SCL) y 'sudo raspi-config' -> I2C"
  fi
fi

echo
[ $BAD = 1 ] && { echo "Hay errores (✘)."; exit 1; }
[ $WARN = 1 ] && echo "Todo lo esencial va; hay avisos (!)." || echo "Todo correcto."
