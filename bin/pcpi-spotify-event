#!/usr/bin/env bash
# Hook de Raspotify/librespot (--onevent): guarda lo que suena para la UI del modo Casa.
# librespot expone PLAYER_EVENT y, al cambiar de cancion, NAME / ARTISTS.
OUT="${PCPI_NOWPLAYING:-/run/pcpi/nowplaying.json}"
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n\t' '  '; }

# ARTISTS llega con un artista por linea: los unimos con ", "
ARTISTS="$(printf '%s' "${ARTISTS:-}" | paste -sd, - | sed 's/,/, /g')"

# COVERS: URLs de la portada (una por linea); nos quedamos con la primera
COVER="$(printf '%s' "${COVERS:-}" | head -n1)"

write() {
  # conservamos titulo/artista/portada si el evento no los trae (p. ej. "paused")
  if [ -z "${NAME:-}" ] && [ -f "$OUT" ]; then
    python3 - "$OUT" "$1" <<'PY' && return
import json, sys
p, st = sys.argv[1:3]
d = json.load(open(p)); d["state"] = st
tmp = p + ".tmp"; open(tmp, "w").write(json.dumps(d)); import os; os.replace(tmp, p)
PY
  fi
  printf '{"state":"%s","title":"%s","artist":"%s","cover":"%s"}\n' "$1" "$(esc "${NAME:-}")" "$(esc "${ARTISTS:-}")" "$(esc "$COVER")" > "$OUT.tmp" && mv "$OUT.tmp" "$OUT"
}

case "${PLAYER_EVENT:-}" in
  track_changed) write playing ;;
  playing)       write playing ;;
  paused)        write paused ;;
  stopped|session_disconnected) write stopped ;;
esac
