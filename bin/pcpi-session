#!/usr/bin/env bash
# Vigilante de modo. Corre DENTRO de la sesion grafica (autostart) y aplica /etc/pcpi/mode:
#   desktop -> sin nada extra (Raspberry Pi OS normal)
#   home    -> Chromium en kiosco (pantalla completa, sin barras) con la UI de Casa
#   iker    -> Chromium en ventana normal (pestañas y barra de direcciones) con el bloc de notas;
#              las notas son la pestaña 1 y "Internet" abre pestañas nuevas
#
# Pantallas de Inicio y de Carga:
#   * Al encender (no existe /run/pcpi/booted) se muestra la pantalla de Inicio (video) y despues la de Carga.
#   * En cada cambio de modo se muestra la de Carga (/loading?to=<modo>). Al acabar, la pagina:
#       - home    : navega ella misma a la UI de Casa (mismo navegador, sin parpadeo)
#       - iker    : avisa con /run/pcpi/loaded y este script abre la ventana normal de Iker
#       - desktop : avisa con /run/pcpi/loaded y este script cierra el navegador
#
# Wi-Fi de pago / portal cautivo: el servidor escribe la direccion en /run/pcpi/portal; mientras exista, este script
# mantiene abierta una ventana normal de Chromium (perfil aparte) para iniciar sesion en la wifi; al desaparecer la cierra.
#
# Robustez: si Chromium se cae, o se queda en blanco/colgado (las paginas envian un latido a /api/alive cada 5 s y
# aqui se vigila /run/pcpi/alive), se mata y se relanza pasando por la pantalla de Carga. Si se repite demasiado
# (mas de 3 veces en 2 minutos) se espera 60 s entre intentos para no entrar en un bucle.
#
# Consumo: el bucle solo usa builtins de bash (sin procesos nuevos) salvo un pgrep cada ~10 s.
set -u
MODE_FILE="${PCPI_MODE_FILE:-/etc/pcpi/mode}"
PORT="${PCPI_PORT:-8080}"
RUN="${PCPI_RUN_DIR:-/run/pcpi}"
TICK="${PCPI_TICK:-1}"                   # segundos entre vueltas (las pruebas lo acortan)
ALIVE_TIMEOUT="${PCPI_ALIVE_TIMEOUT:-45}" # sin latido de la pagina durante tanto tiempo = navegador colgado o en blanco (segundos)
CHECK_EVERY="${PCPI_CHECK_EVERY:-10}"    # cada cuantas vueltas se comprueba el navegador
LOAD_TIMEOUT="${PCPI_LOAD_TIMEOUT:-1800}" # tope de la pantalla de carga (segundos). Es largo porque el primer encendido puede
                                          # descargar un video de ~500 MB; una pagina colgada ya la detecta el latido (45 s)
PROFILE="$HOME/.cache/pcpi-kiosk"        # el perfil de Iker cuelga de este nombre (para poder matar ambos)
PORTAL_PROFILE="$HOME/.cache/pcpi-portal"

# una sola instancia
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/pcpi-session.lock"
flock -n 9 || exit 0

CHROMIUM="$(command -v chromium || command -v chromium-browser || true)"
[ -n "$CHROMIUM" ] || { echo "pcpi-session: Chromium no encontrado" >&2; exit 1; }

stop_browser()  { pkill -f -- "--user-data-dir=$PROFILE" 2>/dev/null || true; }
browser_alive() { pgrep -f -- "--user-data-dir=$PROFILE" >/dev/null; }
portal_alive()  { pgrep -f -- "--user-data-dir=$PORTAL_PROFILE" >/dev/null; }

common_flags() {
  # la coma de --disable-features=A,B es parte del valor, no un separador
  # shellcheck disable=SC2054
  FLAGS=(--no-first-run --no-default-browser-check --noerrdialogs --disable-infobars
         --disable-session-crashed-bubble --password-store=basic
         --check-for-update-interval=31536000 --disable-component-update
         --disable-background-networking --disable-features=Translate,MediaRouter
         --autoplay-policy=no-user-gesture-required)
  [ -n "${WAYLAND_DISPLAY:-}" ] && FLAGS+=(--ozone-platform=wayland)
  return 0
}

wait_server() { for _ in $(seq 30); do curl -sf "http://localhost:$PORT/api/mode" >/dev/null && break; sleep 1; done; }

# Pantalla de Inicio/Carga: siempre en kiosco, con el perfil de Casa
start_loader() {
  local mode="$1" boot="$2"
  common_flags
  wait_server
  FLAGS+=(--kiosk --user-data-dir="$PROFILE" --overscroll-history-navigation=0 --disable-pinch)
  setsid nohup "$CHROMIUM" "${FLAGS[@]}" "http://localhost:$PORT/loading?to=$mode&boot=$boot" >/dev/null 2>&1 9>&- &
}

# El modo ya cargado
start_mode() {
  local mode="$1"
  launched_at="$(now_s)"
  common_flags
  wait_server
  if [ "$mode" = home ]; then
    FLAGS+=(--kiosk --user-data-dir="$PROFILE" --overscroll-history-navigation=0 --disable-pinch)
    setsid nohup "$CHROMIUM" "${FLAGS[@]}" "http://localhost:$PORT/" >/dev/null 2>&1 9>&- &
  elif [ "$mode" = dev ]; then
    FLAGS+=(--start-maximized --user-data-dir="$PROFILE-dev")
    setsid nohup "$CHROMIUM" "${FLAGS[@]}" "http://localhost:$PORT/dev" >/dev/null 2>&1 9>&- &
  else
    FLAGS+=(--start-maximized --user-data-dir="$PROFILE-iker")
    setsid nohup "$CHROMIUM" "${FLAGS[@]}" "http://localhost:$PORT/iker" >/dev/null 2>&1 9>&- &
  fi
}

# Ventana para iniciar sesion en una wifi publica. Solo http/https.
sync_portal() {
  local url=""
  if [ -r "$RUN/portal" ]; then read -r url < "$RUN/portal" 2>/dev/null || true; fi
  case "$url" in http://*|https://*) ;; *) url="" ;; esac
  if [ -n "$url" ]; then
    if ! portal_alive; then
      common_flags
      FLAGS+=(--start-maximized --user-data-dir="$PORTAL_PROFILE")
      setsid nohup "$CHROMIUM" "${FLAGS[@]}" "$url" >/dev/null 2>&1 9>&- &
    fi
  elif portal_alive; then
    pkill -f -- "--user-data-dir=$PORTAL_PROFILE" 2>/dev/null || true
  fi
}

# Ventana de navegador para DYMusic (YouTube / descargador de MP3). El servidor solo deja aqui una direccion https de una
# lista fija; la descarga cae directamente en la carpeta de Musix, asi aparece sola en el MP3 Player.
WEB_PROFILE="$HOME/.cache/pcpi-web"
MUSIC_DIR="${PCPI_MUSIC_DIR:-/var/lib/pcpi/music}"
sync_web() {
  [ -e "$RUN/web" ] || return 0
  local url=""
  read -r url < "$RUN/web" 2>/dev/null || true
  rm -f "$RUN/web" 2>/dev/null || true
  case "$url" in https://*) ;; *) return 0 ;; esac
  case "$url" in *[[:space:]]*|*\"*|*\'*) return 0 ;; esac
  pkill -f -- "--user-data-dir=$WEB_PROFILE" 2>/dev/null || true
  mkdir -p "$WEB_PROFILE/Default" "$MUSIC_DIR" 2>/dev/null || true
  PREFS="$WEB_PROFILE/Default/Preferences" MUSIC_DIR="$MUSIC_DIR" python3 - <<'PY' 2>/dev/null || true
import json, os
p = os.environ["PREFS"]
try:
    d = json.load(open(p))
except (OSError, ValueError):
    d = {}
d.setdefault("download", {}).update({"default_directory": os.environ["MUSIC_DIR"], "prompt_for_download": False, "directory_upgrade": True})
d.setdefault("savefile", {})["default_directory"] = os.environ["MUSIC_DIR"]
json.dump(d, open(p, "w"))
PY
  common_flags
  FLAGS+=(--start-maximized --user-data-dir="$WEB_PROFILE")
  setsid nohup "$CHROMIUM" "${FLAGS[@]}" "$url" >/dev/null 2>&1 9>&- &
}

# Modo Dev: ejecuta las ordenes de la consola (/run/pcpi/dev/in-<id>) con TUS permisos y abre un terminal real si se pide.
# Solo se mira mientras el modo activo es dev. Cada orden tiene tiempo maximo (PCPI_DEV_TIMEOUT, 120 s) y salida limitada.
DEV_TIMEOUT="${PCPI_DEV_TIMEOUT:-120}"
sync_dev() {
  [ "$mode" = dev ] || return 0
  local d="$RUN/dev" f id cmd
  [ -d "$d" ] || return 0
  for f in "$d"/in-*; do
    [ -e "$f" ] || break
    id="${f##*/in-}"
    case "$id" in *[!0-9a-f]*|"") rm -f "$f"; continue ;; esac
    [ "${#id}" -eq 16 ] || { rm -f "$f"; continue; }
    cmd="$(head -c 2000 "$f")"; rm -f "$f"
    (
      cd "$HOME" 2>/dev/null || true
      export TERM=dumb NO_COLOR=1
      timeout -k 3 "$DEV_TIMEOUT" bash -c "$cmd" < /dev/null 2>&1 | head -c 200000 > "$d/out-$id"
      rc="${PIPESTATUS[0]}"
      [ "$rc" = 124 ] && echo "[tiempo agotado: más de ${DEV_TIMEOUT} s]" >> "$d/out-$id"
      echo "$rc" > "$d/code-$id.tmp" && mv -f "$d/code-$id.tmp" "$d/code-$id"
    ) >/dev/null 2>&1 9>&- &
  done
  if [ -e "$d/term" ]; then
    rm -f "$d/term"
    local t
    for t in lxterminal x-terminal-emulator foot xterm; do
      if command -v "$t" >/dev/null; then setsid nohup "$t" >/dev/null 2>&1 9>&- & break; fi
    done
  fi
}

# Sonido: el servidor deja una peticion en /run/pcpi/audio («volume 40», «volume +5», «mute», «unmute», «test») y SOLO esta sesion
# llega al audio del usuario. El estado (volumen, silenciado) queda en /run/pcpi/audio.json y se refresca cada AUDIO_EVERY segundos.
AUDIO_EVERY="${PCPI_AUDIO_EVERY:-45}"
last_audio=-1
audio_refresh() {
  command -v pcpi-sound >/dev/null || return 0
  pcpi-sound status > "$RUN/audio.tmp" 2>/dev/null; mv -f "$RUN/audio.tmp" "$RUN/audio.json" 2>/dev/null || true
}
sync_audio() {
  if [ -e "$RUN/audio" ]; then
    local a="" v=""
    read -r a v < "$RUN/audio" 2>/dev/null || true
    rm -f "$RUN/audio" 2>/dev/null || true
    command -v pcpi-sound >/dev/null || return 0
    case "$a" in
      volume) case "$v" in [0-9]|[0-9][0-9]|100|[+-][0-9]|[+-][0-9][0-9]) pcpi-sound volume "$v" > "$RUN/audio.tmp" 2>/dev/null; mv -f "$RUN/audio.tmp" "$RUN/audio.json" 2>/dev/null || true ;; esac ;;
      mute|unmute) pcpi-sound "$a" > "$RUN/audio.tmp" 2>/dev/null; mv -f "$RUN/audio.tmp" "$RUN/audio.json" 2>/dev/null || true ;;
      test) ( pcpi-sound test >/dev/null 2>&1 ) 9>&- & ;;
    esac
    last_audio=$SECONDS
    return 0
  fi
  if [ "$last_audio" -lt 0 ] || [ $((SECONDS - last_audio)) -ge "$AUDIO_EVERY" ]; then
    last_audio=$SECONDS
    audio_refresh
  fi
}

# Segundos desde el ultimo latido de la pagina (o desde que se lanzo el navegador, lo que sea mas reciente)
now_s() { printf '%(%s)T' -1; }
heartbeat_age() {
  local ts=0 t
  if [ -r "$RUN/alive" ]; then
    # fichero a medio escribir o ilegible: no es prueba de que el navegador este colgado
    read -r ts < "$RUN/alive" 2>/dev/null || { echo 0; return; }
    case "$ts" in ''|*[!0-9]*) echo 0; return ;; esac
  fi
  [ "$ts" -lt "$launched_at" ] && ts=$launched_at
  t="$(now_s)"
  echo $((t - ts))
}

# Relanza el navegador pasando por la carga. Con limite de reintentos.
relaunch() {
  local mode="$1" t
  t="$(now_s)"
  # olvida los reinicios de hace mas de 2 minutos
  local keep=() r
  for r in "${restarts[@]:-}"; do [ -n "$r" ] && [ $((t - r)) -lt 120 ] && keep+=("$r"); done
  restarts=(); [ "${#keep[@]}" -gt 0 ] && restarts=("${keep[@]}")
  if [ "${#restarts[@]}" -ge 3 ] && [ "$t" -lt "$cooldown_until" ]; then return 0; fi
  if [ "${#restarts[@]}" -ge 3 ]; then cooldown_until=$((t + 60)); fi
  restarts+=("$t")
  echo "pcpi-session: el navegador no responde, se relanza ($mode)" >&2
  stop_browser; sleep 0.5
  rm -f "$RUN/loaded" 2>/dev/null || true
  start_loader "$mode" 0
  launched_at="$(now_s)"; phase=loading; loading_since=$SECONDS
}

# Comprobar / instalar actualizaciones. Las lanza esta sesion (el servidor no tiene permisos). Estado en /run/pcpi/update-run
# (running|ok|failed) y registro en /run/pcpi/update.log, que la pantalla enseña. Una sola a la vez.
do_check() {
  command -v pcpi-update >/dev/null || return 0
  ( pcpi-update --check > "$RUN/update.tmp" 2>&1 && mv -f "$RUN/update.tmp" "$RUN/update" ) >/dev/null 2>&1 9>&- &
}
run_update() {
  if [ -e "$RUN/update-run" ] && grep -q '^running' "$RUN/update-run" 2>/dev/null; then return 0; fi
  if ! command -v pcpi-update >/dev/null; then
    printf 'failed\n' > "$RUN/update-run"; echo "No encuentro pcpi-update: ¿está instalado PiCore?" > "$RUN/update.log"; return 0
  fi
  if [ "$(id -u)" -ne 0 ] && ! sudo -n true 2>/dev/null; then
    printf 'failed\n' > "$RUN/update-run"; echo "Actualizar necesita sudo sin contraseña. En la terminal: pcpi-update" > "$RUN/update.log"; return 0
  fi
  printf 'running\n' > "$RUN/update-run"
  (
    if pcpi-update > "$RUN/update.log" 2>&1; then
      pcpi-update --check > "$RUN/update.tmp" 2>&1 && mv -f "$RUN/update.tmp" "$RUN/update"
      printf 'ok\n' > "$RUN/update-run"
    else
      printf 'failed\n' > "$RUN/update-run"
    fi
  ) >/dev/null 2>&1 9>&- &
}

# Apagar / reiniciar / actualizar desde la pantalla: el servidor deja /run/pcpi/power y SOLO esta sesion grafica puede ejecutarlo
sync_power() {
  [ -e "$RUN/power" ] || return 0
  local act=""
  read -r act < "$RUN/power" 2>/dev/null || true
  rm -f "$RUN/power" 2>/dev/null || true
  case "$act" in
    shutdown) echo "pcpi-session: apagando" >&2; systemctl poweroff 2>/dev/null || sudo -n systemctl poweroff ;;
    reboot)   echo "pcpi-session: reiniciando" >&2; systemctl reboot 2>/dev/null || sudo -n systemctl reboot ;;
    update)   echo "pcpi-session: actualizando" >&2; run_update ;;
    check)    do_check ;;
  esac
}

# Actualizacion automatica (opcional, apagada por defecto): si hay novedades y estamos dentro de la franja horaria
# [update] auto_from..auto_to (por defecto 3 a 5 de la madrugada), se instalan solas. Se mira una vez por hora.
AUTO_EVERY="${PCPI_AUTO_EVERY:-3600}"
last_auto=-1
sync_auto() {
  if [ "$last_auto" -ge 0 ] && [ $((SECONDS - last_auto)) -lt "$AUTO_EVERY" ]; then return 0; fi
  last_auto=$SECONDS
  [ "$(pcpi-config get update auto_install 2>/dev/null)" = "true" ] || return 0
  grep -q '^Hay [0-9]' "$RUN/update" 2>/dev/null || return 0
  local h from to
  printf -v h '%(%H)T' -1; h=$((10#$h))
  from="$(pcpi-config get update auto_from 2>/dev/null || echo 3)"; to="$(pcpi-config get update auto_to 2>/dev/null || echo 5)"
  case "$from$to" in *[!0-9]*|"") from=3; to=5 ;; esac
  if [ "$from" -le "$to" ]; then [ "$h" -ge "$from" ] && [ "$h" -lt "$to" ] || return 0
  else [ "$h" -ge "$from" ] || [ "$h" -lt "$to" ] || return 0; fi
  echo "pcpi-session: actualizacion automatica" >&2
  run_update
}

# Comprobacion periodica de actualizaciones (git fetch, sin instalar nada): resultado en /run/pcpi/update
UPDATE_EVERY="${PCPI_UPDATE_EVERY:-604800}"          # 7 dias
UPDATE_FIRST="${PCPI_UPDATE_FIRST:-180}"             # la primera, a los 3 minutos de arrancar (ya hay internet)
last_update_check=-1
sync_update() {
  local due=$UPDATE_EVERY
  [ "$last_update_check" -lt 0 ] && due=$UPDATE_FIRST
  [ "$last_update_check" -lt 0 ] && [ "$SECONDS" -lt "$due" ] && return 0
  [ "$last_update_check" -ge 0 ] && [ $((SECONDS - last_update_check)) -lt "$due" ] && return 0
  last_update_check=$SECONDS
  if command -v pcpi-update >/dev/null && [ "$(pcpi-config get update check 2>/dev/null || echo true)" != "false" ]; then
    ( pcpi-update --check > "$RUN/update.tmp" 2>&1 && mv -f "$RUN/update.tmp" "$RUN/update" ) >/dev/null 2>&1 9>&- &
  fi
}

mkdir -p "$RUN" 2>/dev/null || true
launched_at="$(now_s)"; restarts=(); cooldown_until=0
boot=1; [ -e "$RUN/booted" ] && boot=0          # /run es RAM: tras cada encendido no existe

applied="" ; tick=0 ; phase=running ; loading_since=0
while true; do
  mode=desktop
  read -r mode < "$MODE_FILE" 2>/dev/null || true          # builtin: no lanza procesos
  case "$mode" in desktop|iker|home|dev) ;; *) mode=desktop ;; esac

  if [ "$mode" != "$applied" ]; then
    stop_browser; sleep 0.5
    rm -f "$RUN/loaded" 2>/dev/null || true
    if [ "$boot" = 1 ] || [ -n "$applied" ]; then
      # encendido o cambio de modo -> pantalla de carga (desktop tambien: se ve la transicion)
      phase=loading; loading_since=$SECONDS
      start_loader "$mode" "$boot"
      launched_at="$(now_s)"
      : > "$RUN/booted" 2>/dev/null || true
      boot=0
    else
      # el vigilante se reinicio con el sistema ya en marcha: nada de animaciones, se restaura el modo
      phase=running
      [ "$mode" != desktop ] && start_mode "$mode"
    fi
    applied="$mode"; tick=0
  fi

  if [ "$phase" = loading ]; then
    if [ -e "$RUN/loaded" ] || [ $((SECONDS - loading_since)) -ge "$LOAD_TIMEOUT" ]; then
      rm -f "$RUN/loaded" 2>/dev/null || true
      phase=running; tick=0; launched_at="$(now_s)"
      case "$mode" in
        desktop) stop_browser ;;
        iker|dev) stop_browser; sleep 0.3; start_mode "$mode" ;;
        home)    browser_alive || start_mode home ;;     # la pagina de carga ya navego sola a la UI de Casa
      esac
    fi
  fi

  # ¿Sigue vivo y respondiendo? (en carga y en marcha; no en escritorio)
  if [ "$mode" != desktop ] && [ "$tick" -ge "$CHECK_EVERY" ]; then
    tick=0
    if ! browser_alive; then relaunch "$mode"
    # El latido solo vale para la UI de Casa y la pantalla de carga. En Iker la ventana es un navegador normal:
    # puedes cerrar la pestaña de notas o dejarla oculta (Chromium frena sus temporizadores) y seguir navegando.
    elif { [ "$mode" = home ] || [ "$phase" = loading ]; } && [ "$(heartbeat_age)" -gt "$ALIVE_TIMEOUT" ]; then relaunch "$mode"; fi
  fi

  sync_portal
  sync_web
  sync_dev
  sync_power
  sync_audio
  sync_update
  sync_auto
  tick=$((tick + 1))
  sleep "$TICK" 9>&-
done
