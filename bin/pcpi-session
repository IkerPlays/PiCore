#!/usr/bin/env bash
# Vigilante de modo. Corre DENTRO de la sesion grafica (autostart) y aplica /etc/pcpi/mode:
#   desktop -> sin kiosk (Raspberry Pi OS normal)
#   home    -> Chromium kiosk en http://localhost:PORT/
#   gaming  -> Chromium kiosk en http://localhost:PORT/gaming  (placeholder "Proximamente")
set -u
MODE_FILE="${PCPI_MODE_FILE:-/etc/pcpi/mode}"
PORT="${PCPI_PORT:-8080}"
PROFILE="$HOME/.cache/pcpi-kiosk"

# una sola instancia
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/pcpi-session.lock"
flock -n 9 || exit 0

CHROMIUM="$(command -v chromium || command -v chromium-browser || true)"
[ -n "$CHROMIUM" ] || { echo "pcpi-session: Chromium no encontrado" >&2; exit 1; }

stop_kiosk()  { pkill -f -- "--user-data-dir=$PROFILE" 2>/dev/null || true; }
kiosk_alive() { pgrep -f -- "--user-data-dir=$PROFILE" >/dev/null; }

start_kiosk() {
  local url="$1" flags=()
  [ -n "${WAYLAND_DISPLAY:-}" ] && flags+=(--ozone-platform=wayland)
  for _ in $(seq 30); do curl -sf "http://localhost:$PORT/api/mode" >/dev/null && break; sleep 1; done
  setsid nohup "$CHROMIUM" "${flags[@]}" --kiosk --user-data-dir="$PROFILE" \
    --noerrdialogs --disable-infobars --no-first-run --disable-session-crashed-bubble \
    --overscroll-history-navigation=0 --disable-pinch --check-for-update-interval=31536000 \
    "$url" >/dev/null 2>&1 &
}

applied=""
while true; do
  mode="$(cat "$MODE_FILE" 2>/dev/null || echo desktop)"
  case "$mode" in desktop|gaming|home) ;; *) mode=desktop ;; esac
  if [ "$mode" != "$applied" ]; then stop_kiosk; sleep 0.5; applied="$mode"; fi
  if [ "$mode" != desktop ] && ! kiosk_alive; then
    [ "$mode" = home ] && start_kiosk "http://localhost:$PORT/" || start_kiosk "http://localhost:$PORT/gaming"
  fi
  sleep 1
done
