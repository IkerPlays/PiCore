#!/usr/bin/env bash
# Vigilante de modo. Corre DENTRO de la sesion grafica (autostart) y aplica /etc/pcpi/mode:
#   desktop -> sin nada extra (Raspberry Pi OS normal)
#   home    -> Chromium en kiosco (pantalla completa, sin barras) con la UI de Casa
#   iker    -> Chromium en ventana normal (pestañas y barra de direcciones) con el bloc de notas;
#              las notas son la pestaña 1 y "Internet" abre pestañas nuevas
set -u
MODE_FILE="${PCPI_MODE_FILE:-/etc/pcpi/mode}"
PORT="${PCPI_PORT:-8080}"
PROFILE="$HOME/.cache/pcpi-kiosk"        # el perfil de Iker cuelga de este nombre (para poder matar ambos)

# una sola instancia
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/pcpi-session.lock"
flock -n 9 || exit 0

CHROMIUM="$(command -v chromium || command -v chromium-browser || true)"
[ -n "$CHROMIUM" ] || { echo "pcpi-session: Chromium no encontrado" >&2; exit 1; }

stop_browser()  { pkill -f -- "--user-data-dir=$PROFILE" 2>/dev/null || true; }
browser_alive() { pgrep -f -- "--user-data-dir=$PROFILE" >/dev/null; }

start_browser() {
  local mode="$1" flags=(--no-first-run --noerrdialogs --disable-infobars --disable-session-crashed-bubble
                         --check-for-update-interval=31536000 --password-store=basic)
  [ -n "${WAYLAND_DISPLAY:-}" ] && flags+=(--ozone-platform=wayland)
  for _ in $(seq 30); do curl -sf "http://localhost:$PORT/api/mode" >/dev/null && break; sleep 1; done
  if [ "$mode" = home ]; then
    flags+=(--kiosk --user-data-dir="$PROFILE" --overscroll-history-navigation=0 --disable-pinch)
    setsid nohup "$CHROMIUM" "${flags[@]}" "http://localhost:$PORT/" >/dev/null 2>&1 &
  else
    flags+=(--start-maximized --user-data-dir="$PROFILE-iker")
    setsid nohup "$CHROMIUM" "${flags[@]}" "http://localhost:$PORT/iker" >/dev/null 2>&1 &
  fi
}

applied=""
while true; do
  mode="$(cat "$MODE_FILE" 2>/dev/null || echo desktop)"
  case "$mode" in desktop|iker|home) ;; *) mode=desktop ;; esac
  if [ "$mode" != "$applied" ]; then stop_browser; sleep 0.5; applied="$mode"; fi
  if [ "$mode" != desktop ] && ! browser_alive; then start_browser "$mode"; fi
  sleep 1
done
