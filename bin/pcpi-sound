#!/usr/bin/env python3
"""Volumen y prueba de sonido (lo mismo que el panel «Pantalla y sonido» de la pantalla tactil).

  pcpi-sound status          estado en JSON (volumen, silenciado, a traves de que programa)
  pcpi-sound volume 40       volumen al 40 %    (tambien +5 / -5 para subir o bajar)
  pcpi-sound mute | unmute | toggle
  pcpi-sound test            suena un par de tonos por el altavoz por defecto
  pcpi-sound devices         salidas y entradas de audio (incluye Bluetooth) en JSON
  pcpi-sound use-output 58   elige la salida (el numero sale de «devices»)
  pcpi-sound use-input 59    elige la entrada (microfono)
  pcpi-sound use-bluetooth AA:BB:CC:DD:EE:FF   deja como salida ese aparato Bluetooth (ya conectado)

Usa PipeWire (wpctl) o, si no esta, ALSA (amixer)."""
import json
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True
HERE = Path(os.path.realpath(__file__)).parent
for cand in (HERE.parent / "home", Path("/opt/pcpi/home")):
    if (cand / "sound.py").exists():
        sys.path.insert(0, str(cand))
        break
import sound  # noqa: E402


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    try:
        if cmd == "status":
            out = sound.status()
        elif cmd == "volume" and len(argv) > 2:
            out = sound.set_volume(argv[2])
        elif cmd in ("mute", "unmute", "toggle"):
            out = sound.set_mute(cmd)
        elif cmd == "devices":
            out = sound.devices()
        elif cmd in ("use-output", "use-input") and len(argv) > 2:
            out = sound.set_default("output" if cmd == "use-output" else "input", argv[2])
        elif cmd == "use-bluetooth" and len(argv) > 2:
            out = sound.use_bluetooth(argv[2])
            print(json.dumps(out, ensure_ascii=False))
            return 0 if out["ok"] else 1
        elif cmd == "test":
            ok = sound.play_test()
            print("Sonando…" if ok else "No pude reproducir: ¿hay altavoz y aplay/paplay/pw-play?", file=sys.stdout if ok else sys.stderr)
            return 0 if ok else 1
        else:
            print(__doc__)
            return 2
    except ValueError as e:
        print("Error: %s" % e, file=sys.stderr)
        return 2
    print(json.dumps(out, ensure_ascii=False))
    return 0 if out.get("available") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
