# /etc/pcpi/pcpi.conf  (el instalador la crea si no existe)

[server]
host = 127.0.0.1
port = 8080
# Nombres extra con los que se puede abrir la pagina (por defecto solo localhost / 127.0.0.1). Separados por comas.
# allowed_hosts = pcpi.local

[pihole]
# Pi-hole v6. Deja la password vacia si tu Pi-hole no la pide.
url = http://localhost
password =

[weather]
# Open-Meteo (sin API key). Vacio = sin tiempo. Ejemplo: Madrid
lat = 25
lon = -12.234

[voice]
# Asistente de voz local (./install.sh --voice).
# Motor de la palabra de activacion: openwakeword (modelo dedicado, recomendado) o vosk (plan B).
wake_engine = openwakeword
# Modelo incluido: hey_jarvis, alexa, hey_mycroft, hey_marvin, timer, weather.
# O un .onnx propio: oye_pi_experimental (poco fiable, ver training/RESULTADOS.md) o tu ruta, p. ej. /opt/pcpi/models/wake/mi_modelo.onnx.
wake_model = hey_jarvis
# 0-1. Sube si se activa solo; baja si no te hace caso.
wake_threshold = 0.5
# Segundos que espera tu orden tras el pitido.
followup_s = 8
# Solo para wake_engine = vosk: frases de activacion separadas por comas.
wake = oye pi,hey pi,oye casa
# Reconocimiento de la ORDEN (lo que dices tras el pitido): auto = Whisper si esta instalado (mejor, sin conexion), si no Vosk;
# whisper o vosk para forzarlo.
stt = auto
# Modelo de Whisper (tiny, base, small): base va bien en la Pi 5; small acierta mas pero tarda ~3 veces mas. Se descarga
# al instalar (./install.sh --voice) en whisper_dir y despues funciona SIN internet.
whisper_model = base
whisper_dir = /opt/pcpi/models/whisper
# Hilos de CPU para Whisper (la Pi 5 tiene 4 nucleos).
whisper_threads = 4
# Dispositivo de captura de arecord ("arecord -l" para listarlos). default = el del sistema.
device = default
# Voz de espeak-ng
tts_voice = es

[camera]
# Camara USB en el modo Casa (boton "Camara" o voz). Solo se enciende mientras la ves.
enabled = true
device = /dev/video0
size = 640x480
fps = 15
# mjpeg = la webcam ya entrega JPEG (casi sin CPU). Vacio = recodifica (mas CPU).
input_format = mjpeg
# Opcional: otro origen, p.ej. una camara IP. Debe sacar MJPEG (mpjpeg, boundary "frame") por stdout.
# command = ffmpeg -loglevel error -i rtsp://usuario:clave@192.168.1.50/stream -c:v mjpeg -q:v 7 -f mpjpeg -boundary_tag frame -

[mini]
# Mini pantalla OLED I2C de estado (./install.sh --stats). Ver docs/PANTALLA_MINI.md
# (Los comentarios van SIEMPRE en su propia linea, nunca al final de un valor.)

# Direccion I2C. Algunas pantallas usan 0x3D (mira 'sudo i2cdetect -y 1').
address = 0x3C
i2c_bus = 1
# Chip: ssd1306 (lo habitual) o sh1106. Si la imagen sale desplazada 2 columnas o con basura en el borde, pon sh1106.
chip = ssd1306
# true = girar la imagen 180 grados
rotate = false
# Segundos entre actualizaciones
interval = 1
# Brillo 0-255
contrast = 120
# Los OLED se desgastan si estan siempre encendidos: apagala por la noche (horas 0-23, -1 = nunca)
off_from = -1
off_to = -1

[boot]
# Pantalla de Inicio (al encender) y pantalla de Carga (al encender y en cada cambio de modo).
# Tus videos/imagenes van en extra-assets/ (ver extra-assets/README.md).
# Reproducir un video de extra-assets/start/ al encender (si no hay ninguno, se salta solo).
intro = true
# Hasta 4 videos: Inicio1.mp4 (vale tambien Inicio.mp4), Inicio2.mp4, Inicio3.mp4 e Inicio4.mp4. Al encender sale UNO al azar.
# Probabilidad de cada uno (pesos relativos: con 90, 85, 55 y 1 salen ~38,9 %, 36,8 %, 23,8 % y 0,4 %).
intro_chances = 90, 85, 55, 1
# Garantia: si el video raro lleva este numero de encendidos SIN salir, en el siguiente sale si o si (0 = sin garantia).
intro_pity = 4
# A que videos se aplica la garantia (por defecto solo al 4.º, el raro). Ejemplo para todos: 1, 2, 3, 4
intro_pity_slots = 4
# El video del intro 4 NO esta en GitHub (pesa unos 500 MB): se descarga UNA vez, la primera vez que se enciende la Pi
# (con pantalla de progreso), a extra-assets/start/Inicio4.mp4, y no se vuelve a bajar. Vacio = no descargar.
intro4_url = https://pcraspberrypi-video.netlify.app/ayuda.mp4
# Segundos tras los que aparece un boton pequeño «Saltar» (esquina inferior derecha) en cada video; 0 = nunca.
intro_skip_seconds = 0, 0, 0, 6
# Tras llegar al 85 % real, el efecto TV «x2» sube hasta el 100 % (carga rapida). false = pasa directo.
fake_loading = true
# Segundos que dura ese tramo final del 85 % al 100 % (1-30).
fake_seconds = 6
# Tiempo minimo de la pantalla de carga aunque todo cargue antes (0-30), para que se vea.
min_seconds = 3
# Mostrar el boton «Saltar» durante el tramo x2.
skip_button = true
# Segundos que se ve cada imagen/GIF/video de la carga (1-20).
media_seconds = 3

[wifi]
# Gestion de Wi-Fi con NetworkManager (panel en la pantalla y «pcpi-wifi»).
# false = PiCore no toca nada de la red.
manage = true
# En las redes NUEVAS, usar el Pi-hole como DNS (se puede cambiar red por red en el panel o con «pcpi-wifi pihole»).
pihole_default = true
# Abrir solo la ventana de inicio de sesion cuando una wifi publica lo pida (hotel, aeropuerto...).
# false = no se abre sola; sale un boton «Iniciar sesion» en el panel de Wi-Fi.
auto_portal = true
# Direccion con la que se comprueba si hay internet libre o un portal (cada 60 s, y cada 4 s mientras haya portal).
# Debe devolver «204 sin contenido» cuando hay internet. Por defecto la de Google (generate_204); si no quieres que
# la Pi la consulte, pon otra (p. ej. http://connectivity-check.ubuntu.com/) o la de tu propio servidor.
# probe_url = http://connectivitycheck.gstatic.com/generate_204

[display]
# Brillo. El deslizante de la pantalla de Casa (icono ☀) elige el nivel maximo; en automatico baja de noche.
# Hora a la que empieza la noche (0-23) y a la que acaba.
night_from = 22
night_to = 7
# Brillo (10-100 %) durante la noche.
night_level = 40
# Minutos en los que el brillo baja (antes de night_from) y sube (despues de night_to) poco a poco.
ramp_minutes = 60

[notes]
# Copia automatica de tus notas (maximo una por hora, solo si han cambiado) en /var/lib/pcpi/backups.
backup = true
# Cuantas copias se guardan.
backup_keep = 7

[motion]
# Deteccion de movimiento con la camara (aviso en la pantalla de Casa). Tambien se activa con el icono 👁.
# Privacidad: compara fotogramas diminutos en memoria; NO guarda ni envia imagenes.
# Coste: mantiene la camara abierta (algo de CPU); se pausa sola mientras ves la camara.
enabled = false
# low, medium o high
sensitivity = medium
# Segundos minimos entre un aviso y el siguiente.
cooldown = 30
# Fotogramas por segundo que se analizan (1-10).
fps = 2

[battery]
# La Raspberry Pi 5 NO mide la bateria. Un indicador solo existe si tienes un UPS/HAT con bateria que aparezca en
# /sys/class/power_supply, o un comando propio que escriba el porcentaje (p. ej. "87" o "87 charging"):
# command = /usr/local/bin/mi-ups-porcentaje
# Avisos (en %): bateria baja y critica.
low_percent = 20
critical_percent = 10

[ai]
# IA local con Ollama (./install.sh --ai). Responde preguntas con datos reales de la Pi, SIN internet. Solo contesta:
# no ejecuta acciones (para eso estan las ordenes de voz). Si una orden de voz no se reconoce, se la pasa a la IA.
enabled = false
# Modelo de Ollama. qwen2.5:1.5b (recomendado), qwen2.5:3b (mejor, ~2x mas lento), qwen2.5:0.5b (muy rapido, justito).
model = qwen2.5:1.5b
# Donde escucha Ollama (la misma Pi).
url = http://127.0.0.1:11434
# Largo maximo de la respuesta (en «trozos» de palabra; ~160 = unas 100 palabras) y tiempo maximo de espera (segundos).
max_tokens = 160
timeout = 90
# Cuanto tiempo se queda el modelo en RAM tras contestar (libera memoria despues).
keep_alive = 2m

