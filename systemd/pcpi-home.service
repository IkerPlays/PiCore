[Unit]
Description=PiCore - servidor de la UI (modo Casa / Gaming)
After=network-online.target

[Service]
User=__USER__
Environment=PCPI_CONF=/etc/pcpi/pcpi.conf
ExecStart=/usr/bin/python3 /opt/pcpi/home/server.py
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Endurecimiento (no hace falta ningun privilegio: el servidor escucha en un puerto alto y llama a nmcli/ffmpeg como usuario)
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectClock=true
ProtectHostname=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/etc/pcpi /var/lib/pcpi -/run/pcpi -/media -/run/media -/mnt -/opt/pcpi/extra-assets/start

[Install]
WantedBy=multi-user.target
